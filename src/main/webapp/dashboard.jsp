<%@ page import="com.codequest.util.WebUtil" %><%@ page contentType="text/html;charset=UTF-8" %><%if(!WebUtil.student(request)){response.sendRedirect("login.jsp");return;}int xp=request.getAttribute("xp")==null?0:(Integer)request.getAttribute("xp");int level=request.getAttribute("level")==null?1:(Integer)request.getAttribute("level");int progress=xp%100;%><!DOCTYPE html><html><head><title>Your Dashboard</title><link rel="stylesheet" href="css/style.css"></head><body><nav class="nav"><a class="brand" href="index.html">⚡ CodeQuest</a><div><a href="MissionServlet">Missions</a><a href="LeaderboardServlet">Leaderboard</a><a href="LogoutServlet">Logout</a></div></nav><main class="wrap"><h1 class="page-title">Welcome, <%=WebUtil.esc((String)request.getAttribute("username"))%> 👋</h1><p class="sub">Every solved problem takes you one step further.</p><%if(request.getAttribute("error")!=null){%><div class="alert"><%=request.getAttribute("error")%></div><%}%><div class="grid"><div class="card metric"><strong><%=xp%></strong><span>Total XP</span></div><div class="card metric"><strong>Level <%=level%></strong><span>Current rank</span></div><div class="card metric"><strong><%=request.getAttribute("completed")%></strong><span>Correct missions</span></div></div><div class="card"><div class="row"><b>Next level progress</b><span class="muted"><%=progress%> / 100 XP</span></div><div class="progress"><span style="width:<%=progress%>%"></span></div><p class="muted">Earn <%=100-progress%> more XP to reach the next level.</p></div><div class="actions" style="justify-content:flex-start;margin:25px 0"><a class="btn primary" href="MissionServlet">Explore missions →</a><a class="btn ghost" href="LeaderboardServlet">View leaderboard</a></div></main></body></html>