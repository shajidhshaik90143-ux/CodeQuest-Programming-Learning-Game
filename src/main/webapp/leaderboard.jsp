<%@ page import="java.util.*,com.codequest.util.WebUtil" %><%@ page contentType="text/html;charset=UTF-8" %><%List<Map<String,Object>> ps=(List<Map<String,Object>>)request.getAttribute("players");%><!DOCTYPE html><html><head><title>Leaderboard</title><link rel="stylesheet" href="css/style.css"></head><body><nav class="nav"><a class="brand" href="index.html">⚡ CodeQuest</a><div><a href="DashboardServlet">Dashboard</a><a href="MissionServlet">Missions</a><a href="index.html">Home</a></div></nav><main class="wrap"><h1 class="page-title">Global leaderboard 🏆</h1><p class="sub">The top problem solvers in CodeQuest.</p><%if(request.getAttribute("error")!=null){%><div class="alert"><%=request.getAttribute("error")%></div><%}%><div class="card table-wrap"><table><tr><th>Rank</th><th>Student</th><th>Level</th><th>Completed</th><th>Total XP</th></tr><%if(ps!=null)for(Map<String,Object> m:ps){int rank=(Integer)m.get("rank");%><tr><td class="rank"><%=rank==1?"🥇":rank==2?"🥈":rank==3?"🥉":"#"+rank%></td><td><%=WebUtil.esc((String)m.get("username"))%></td><td><%=m.get("level")%></td><td><%=m.get("completed")%></td><td><b><%=m.get("xp")%></b></td></tr><%}%></table><%if(ps==null||ps.isEmpty()){%><p class="muted center">No players yet. Be the first to join CodeQuest!</p><%}%></div></main></body></html>