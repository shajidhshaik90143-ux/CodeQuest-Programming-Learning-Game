<%@ page import="java.util.*,com.codequest.util.WebUtil" %><%@ page contentType="text/html;charset=UTF-8" %><%if(!WebUtil.admin(request)){response.sendRedirect("admin-login.jsp");return;}List<Map<String,Object>> qs=(List<Map<String,Object>>)request.getAttribute("questions");%><!DOCTYPE html><html><head><title>Manage Missions</title><link rel="stylesheet" href="css/style.css"></head><body><nav class="nav"><a class="brand" href="admin-dashboard.jsp">⚡ CodeQuest Admin</a><div><a href="add-question.jsp">Add mission</a><a href="AdminLogoutServlet">Logout</a></div></nav><main class="wrap"><div class="row"><div><h1 class="page-title">Mission library</h1><p class="sub">Questions stored in your database.</p></div><a class="btn primary" href="add-question.jsp">＋ Add mission</a></div><%if(request.getAttribute("error")!=null){%><div class="alert"><%=request.getAttribute("error")%></div><%}%><div class="card table-wrap"><table><tr><th>Title</th><th>Category</th><th>Difficulty</th><th>XP</th></tr><%if(qs!=null)for(Map<String,Object> m:qs){%><tr><td><%=WebUtil.esc((String)m.get("title"))%></td><td><%=m.get("category")%></td><td><%=m.get("difficulty")%></td><td><%=m.get("xp")%></td></tr><%}%></table><%if(qs==null||qs.isEmpty()){%><p class="muted">No missions created yet.</p><%}%></div></main></body></html>