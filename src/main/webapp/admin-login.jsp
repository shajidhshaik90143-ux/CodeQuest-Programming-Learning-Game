<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Admin Login</title><link rel="stylesheet" href="css/style.css"></head><body><nav class="nav"><a class="brand" href="index.html">⚡ CodeQuest</a><div><a href="index.html">Home</a></div></nav><main class="wrap narrow"><h1 class="page-title">Admin access</h1><p class="sub">Manage the programming mission library.</p><div class="card"><%if(request.getAttribute("error")!=null){%><div class="alert"><%=request.getAttribute("error")%></div><%}%><form method="post" action="AdminLoginServlet"><div class="field"><label>Admin username or email</label><input name="identity" required></div><div class="field"><label>Password</label><input type="password" name="password" required></div><button class="btn primary btn-submit">Sign in as admin</button></form></div></main></body></html>