<%@ page import="java.util.*,com.codequest.util.WebUtil" %><%@ page contentType="text/html;charset=UTF-8" %><%if(!WebUtil.student(request)){response.sendRedirect("login.jsp");return;}List<Map<String,Object>> ms=(List<Map<String,Object>>)request.getAttribute("missions");String result=(String)session.getAttribute("result");if(result!=null)session.removeAttribute("result");%><!DOCTYPE html><html><head><title>Programming Missions</title><link rel="stylesheet" href="css/style.css"></head><body><nav class="nav"><a class="brand" href="DashboardServlet">⚡ CodeQuest</a><div><a href="LeaderboardServlet">Leaderboard</a><a href="LogoutServlet">Logout</a></div></nav><main class="wrap"><h1 class="page-title">Programming missions</h1><p class="sub">Pick a challenge. One attempt per mission, so think before you submit.</p><%if(result!=null){%><div class="alert success"><%=WebUtil.esc(result)%></div><%}%><%if(request.getAttribute("error")!=null){%><div class="alert"><%=request.getAttribute("error")%></div><%}%><div class="grid"><%if(ms!=null)for(Map<String,Object> m:ms){boolean attempted=m.get("attempted")!=null;%><div class="card mission"><div><span class="tag"><%=m.get("category")%></span><span class="tag"><%=m.get("difficulty")%></span><span class="tag"><%=m.get("xp_reward")%> XP</span></div><h3><%=WebUtil.esc((String)m.get("title"))%></h3><p class="muted"><%=WebUtil.esc((String)m.get("description"))%></p><%if(attempted){%><p class="muted"><b><%=Boolean.TRUE.equals(m.get("is_correct"))?"✓ Completed successfully":"Attempt used" %></b> — this mission is locked.</p><%}else{%><form method="post" action="SubmitAnswerServlet"><input type="hidden" name="missionId" value="<%=m.get("id")%>"><%String[] keys={"A","B","C","D"};String[] cols={"option_a","option_b","option_c","option_d"};for(int i=0;i<4;i++){%><label class="option"><input type="radio" name="answer" value="<%=keys[i]%>" required><b><%=keys[i]%>.</b> <%=WebUtil.esc((String)m.get(cols[i]))%></label><%}%><button class="btn primary btn-submit">Submit answer</button></form><%}%></div><%}%></div><%if(ms==null||ms.isEmpty()){%><div class="card muted">No missions available yet. Check back soon.</div><%}%></main></body></html>