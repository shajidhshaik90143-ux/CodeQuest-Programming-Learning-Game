<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Student Login</title><link rel="stylesheet" href="css/style.css"></head><body><nav class="nav"><a class="brand" href="index.html">⚡ CodeQuest</a><div><a href="register.jsp">Register</a><a href="index.html">Home</a></div></nav><main class="wrap narrow"><h1 class="page-title">Welcome back</h1><p class="sub">Sign in and continue your quest.</p><div class="card"><%String flash=(String)session.getAttribute("flash");if(flash!=null){session.removeAttribute("flash");%><div class="alert success"><%=flash%></div><%}%><%if(request.getAttribute("error")!=null){%><div class="alert"><%=request.getAttribute("error")%></div><%}%><form method="post" action="LoginServlet"><div class="field"><label>Username or email</label><input name="identity" required></div><div class="field"><label>Password</label><input type="password" name="password" required></div><button class="btn primary btn-submit">Login</button></form></div><p class="muted center">New here? <a class="toplink" href="register.jsp">Create account</a></p></main></body></html>